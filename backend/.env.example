# SpendSense Environment Configuration
# Copy this file to .env and adjust variables as needed

# Security & JWT Configuration
SECRET_KEY=spendsense_super_secure_jwt_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database Location (defaults to backend/spendsense.db)
DATABASE_PATH=backend/spendsense.db

# Optional Amazon S3 Cloud Storage
# Leave empty to run SpendSense in full local-only mode (No AWS account required!)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
